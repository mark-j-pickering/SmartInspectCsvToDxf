<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <AssemblyName>SmartInspectCsvToDxf</AssemblyName>
    <Product>The VAG Inspector</Product>
    <!-- Dev-time fallback only. CI overrides this via `dotnet publish -p:Version=X.Y.Z`,
         derived from the pushed `vX.Y.Z` git tag - see .github/workflows/release.yml. -->
    <Version>0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="netDxf" Version="2022.11.2" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\vag_logo.png" />
  </ItemGroup>

</Project>
